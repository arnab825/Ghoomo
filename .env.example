# ==============================================================================
# BHARAT SMART TOURISM PLATFORM (SIH26207) - ENVIRONMENT VARIABLES TEMPLATE
# Copy this file to '.env.local' or '.env' for local development.
# NOTE: All AI and Supabase features have automatic deterministic fallbacks
# enabled so the platform works out-of-the-box even without API keys!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase (Database & Authentication)
# ------------------------------------------------------------------------------
# Get these from your Supabase Dashboard: Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# ------------------------------------------------------------------------------
# 2. AI Services (Multi-LLM Orchestrator)
# ------------------------------------------------------------------------------
# Google Gemini API Key for deep itinerary generation & cultural storytelling:
# Get free key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key

# Grok / Groq API Key for ultra-fast dynamic weather/delay rerouting (optional):
# Get free key from: https://console.groq.com/keys
GROK_API_KEY=your-grok-or-groq-api-key

# Hugging Face API Token for regional Indian language translation tasks (optional):
# Get token from: https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY=your-huggingface-token

# ------------------------------------------------------------------------------
# 3. Application Settings
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
