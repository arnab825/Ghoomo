# ==============================================================================
# GHOOMO - AI-POWERED EXPERIENTIAL LEARNING PLATFORM
# Environment Variables Template
# Copy this file to '.env' or '.env.local' for local development.
# NEVER commit real secret keys, service keys, or passwords to git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase (Database & Authentication)
# ------------------------------------------------------------------------------
# From Supabase Dashboard: Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Supabase Service Role Key (Used strictly for server scripts / DB seeding - keep secret!)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# PostgreSQL Connection String (From Supabase Settings > Database)
DATABASE_URL=postgresql://postgres.your-project-id:your-db-password@aws-0-ap-south-1.pooler.supabase.com:6543/postgres

# ------------------------------------------------------------------------------
# 2. Google OAuth (Google Cloud Console > Credentials > OAuth 2.0 Client ID)
# ------------------------------------------------------------------------------
# These are configured in Supabase Dashboard > Authentication > Providers > Google.
# You can also keep references here for dev tracking:
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ------------------------------------------------------------------------------
# 3. AI Services (Multi-LLM Orchestrator)
# ------------------------------------------------------------------------------
# Google Gemini API Key for smart journey generation & quiz creation (Required for live AI):
# Get free key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key

# Groq API Key for fast fallback rerouting / quizzes (Optional):
# Get free key from: https://console.groq.com/keys
GROQ_API_KEY=your-groq-api-key

# Hugging Face API Token for regional Indian language translations (Optional):
# Get token from: https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY=your-huggingface-token

# ------------------------------------------------------------------------------
# 4. Application Settings
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 5. Payment Gateway (Razorpay - Optional for live checkout)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_yourKeyIdHere
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
