# ==============================================================================
# Ghoomo Bharat Environment Variables Template
# Copy this file to .env.local or .env for local development.
# NEVER commit real secret keys or passwords to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Frontend / Public Configuration (Safe to expose to client)
# ------------------------------------------------------------------------------
# Supabase project URL and anonymous client API key (guarded by Row-Level Security)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Canonical App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Razorpay Public Key ID (Required only if live Razorpay payment gateway is enabled)
# For local demo mode, leave blank or set to your test key
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_yourKeyIdHere

# ------------------------------------------------------------------------------
# 2. Server-Side Secret Credentials (NEVER expose to browser/client bundles)
# ------------------------------------------------------------------------------
# Razorpay Key Secret for server-side HMAC SHA256 payment signature verification
RAZORPAY_KEY_SECRET=your-razorpay-key-secret

# Supabase Service Role Key (Used strictly for server scripts / DB seeding)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# AI Provider API Keys (Used strictly on server actions and API routes)
GEMINI_API_KEY=your-gemini-api-key
GROQ_API_KEY=your-groq-or-grok-api-key
HUGGINGFACE_API_KEY=your-huggingface-token

